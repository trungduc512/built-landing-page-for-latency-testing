# HTTP port the result-collection API listens on (Nginx proxies /api here).
PORT=8787

# SQLite database file path. In Docker this is /data/results.db (a mounted volume).
DB_PATH=./data/results.db

# Origin of the frontend site, used for CORS on /api (use * only for local dev).
ALLOWED_ORIGIN=https://latency.example.com

# Bearer token required for admin read/export endpoints. Set to a long random secret.
ADMIN_TOKEN=change-me-to-a-long-random-secret

# SQLite durability: 'FULL' (safest, default) or 'NORMAL' (faster, still durable on clean shutdown).
DB_SYNCHRONOUS=FULL
